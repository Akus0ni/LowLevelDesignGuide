<Project Sdk="Microsoft.NET.Sdk">

  <!-- Compiled C# for the GoF and Enterprise pattern lessons (spec 006). One folder per pattern under its category,
       with Before / After / Modern namespaces; lessons quote these types by name and Lld.Samples.Tests proves them. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- "Modern C#" versions show how the DI container replaces hand-made singletons and factories. -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
  </ItemGroup>

</Project>
