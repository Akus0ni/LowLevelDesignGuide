<Project Sdk="Aspire.AppHost.Sdk/13.6.1">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AspireUseCliBundle>true</AspireUseCliBundle>
    <UserSecretsId>lld-guide-apphost</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <!-- No ProjectReference to Lld.App: the MAUI integration references it by path. -->
    <ProjectReference Include="..\Lld.Api\Lld.Api.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.DevTunnels" />
    <PackageReference Include="Aspire.Hosting.JavaScript" />
    <PackageReference Include="Aspire.Hosting.Maui" />
  </ItemGroup>

</Project>
