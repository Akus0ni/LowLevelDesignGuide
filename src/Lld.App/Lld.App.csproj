<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- -p:SkipAndroid=true builds without the maui-android workload (e.g. Windows-only builds). -->
    <TargetFrameworks Condition="'$(SkipAndroid)' != 'true'">net10.0-android</TargetFrameworks>
    <!-- Apple targets build only on macOS (no Mac is paired with the Windows dev machine; CI builds them). -->
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('osx'))">$(TargetFrameworks);net10.0-ios;net10.0-maccatalyst</TargetFrameworks>
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net10.0-windows10.0.19041.0</TargetFrameworks>

    <OutputType>Exe</OutputType>
    <RootNamespace>Lld.App</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <MauiXamlInflator>SourceGen</MauiXamlInflator>

    <ApplicationTitle>LLD Guide</ApplicationTitle>
    <ApplicationId>com.akus0ni.lldguide</ApplicationId>
    <ApplicationDisplayVersion>0.1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>

    <WindowsPackageType>None</WindowsPackageType>

    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">15.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">24.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
    <TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
  </PropertyGroup>

  <ItemGroup>
    <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#4F46E5" />
    <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#4F46E5" BaseSize="128,128" />
    <MauiFont Include="Resources\Fonts\*" />
    <MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" />
    <PackageReference Include="CommunityToolkit.Maui" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Lld.Contracts\Lld.Contracts.csproj" />
    <ProjectReference Include="..\Lld.Content\Lld.Content.csproj" />
    <ProjectReference Include="..\Lld.App.ServiceDefaults\Lld.App.ServiceDefaults.csproj" />
    <ProjectReference Include="..\Lld.ServerStatus\Lld.ServerStatus.csproj" />
  </ItemGroup>

  <!--
    Hosting settings (spec 002), embedded so they work on every platform without file access:
    appsettings.json is committed (public key); appsettings.local.json is git-ignored (ntfy topic, tunnel URL)
    and embedded only when it exists, so CI builds without it.
  -->
  <ItemGroup>
    <EmbeddedResource Include="appsettings.json" LogicalName="Lld.App.appsettings.json" />
    <EmbeddedResource Include="appsettings.local.json" LogicalName="Lld.App.appsettings.local.json" Condition="Exists('appsettings.local.json')" />
  </ItemGroup>

  <!--
    Build the React app (vite mode "maui") and package it as the HybridWebView root ("wwwroot").
    Skip with -p:SkipWebBuild=true when the bundle in web/dist-app is already built (e.g. in CI).
    Incremental: reruns only when web sources change. Build one target framework at a time (-f)
    so parallel inner builds never run npm concurrently.
  -->
  <PropertyGroup>
    <WebProjectDir>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\..\web\'))</WebProjectDir>
    <WebAppOutputDir>$(WebProjectDir)dist-app\</WebAppOutputDir>
  </PropertyGroup>

  <ItemGroup>
    <WebAppSource Include="$(WebProjectDir)src\**;$(WebProjectDir)index.html;$(WebProjectDir)package.json;$(WebProjectDir)vite.config.ts" />
  </ItemGroup>

  <Target Name="BuildWebApp" BeforeTargets="BeforeBuild" Condition="'$(SkipWebBuild)' != 'true'"
          Inputs="@(WebAppSource)" Outputs="$(WebAppOutputDir)index.html">
    <Exec Command="npm ci --no-fund --no-audit" WorkingDirectory="$(WebProjectDir)" Condition="!Exists('$(WebProjectDir)node_modules')" />
    <Exec Command="npm run build:app" WorkingDirectory="$(WebProjectDir)" />
  </Target>

  <!-- Files produced during the build are not seen by evaluation-time globs, so add them here. -->
  <Target Name="IncludeWebApp" AfterTargets="BuildWebApp" BeforeTargets="BeforeBuild">
    <Error Condition="!Exists('$(WebAppOutputDir)index.html')"
           Text="Web bundle not found in $(WebAppOutputDir). Run 'npm run build:app' in web/ or build without SkipWebBuild." />
    <ItemGroup>
      <_WebAppFile Include="$(WebAppOutputDir)**" />
      <MauiAsset Include="@(_WebAppFile)" LogicalName="wwwroot\%(RecursiveDir)%(Filename)%(Extension)" />
    </ItemGroup>
  </Target>

  <!--
    Content (spec 003): validate and pack content/ with the lld-content tool, and ship the pack as MAUI assets under
    "content/". It runs on every build (a deleted lesson changes no input timestamp, so Inputs/Outputs would miss it);
    the tool rewrites its files only when the content changed, so the asset copy stays incremental.
    Broken content fails the build with file(line) errors.
  -->
  <PropertyGroup>
    <ContentCliProject>$(MSBuildThisFileDirectory)..\Lld.Content.Cli\Lld.Content.Cli.csproj</ContentCliProject>
    <ContentRepositoryRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\..'))</ContentRepositoryRoot>
    <ContentDotnet Condition="'$(DOTNET_HOST_PATH)' != ''">"$(DOTNET_HOST_PATH)"</ContentDotnet>
    <ContentDotnet Condition="'$(DOTNET_HOST_PATH)' == ''">dotnet</ContentDotnet>
  </PropertyGroup>

  <Target Name="PackContent" BeforeTargets="BeforeBuild">
    <!-- Inside the target: IntermediateOutputPath (per target framework) isn't known when the project body is evaluated. -->
    <PropertyGroup>
      <ContentPackDir>$([System.IO.Path]::Combine('$(MSBuildProjectDirectory)', '$(IntermediateOutputPath)', 'content-pack'))</ContentPackDir>
    </PropertyGroup>
    <!-- Build the tool for this machine, without the app's platform settings (Android RID, trimming, AOT, output folders). -->
    <MSBuild Projects="$(ContentCliProject)" Targets="Build" Properties="Configuration=$(Configuration)"
             RemoveProperties="TargetFramework;RuntimeIdentifier;SelfContained;Platform;PublishDir;OutputPath;OutDir;_CommandLineDefinedOutputPath;PublishTrimmed;TrimMode;RunAOTCompilation;AndroidEnableProfiledAot;SkipWebBuild">
      <Output TaskParameter="TargetOutputs" ItemName="_ContentCliAssembly" />
    </MSBuild>
    <Exec Command="$(ContentDotnet) &quot;@(_ContentCliAssembly)&quot; pack --repo &quot;$(ContentRepositoryRoot)&quot; --out &quot;$(ContentPackDir)&quot; --format MSBuild"
          IgnoreExitCode="true">
      <Output TaskParameter="ExitCode" PropertyName="_ContentPackExitCode" />
    </Exec>
    <!-- Content issues are printed above as clickable file(line) errors; this stops the build without MSBuild's
         generic "command exited with code 1" line. -->
    <Error Condition="'$(_ContentPackExitCode)' != '0'" Text="lld-content pack failed (exit code $(_ContentPackExitCode)); see the output above." />
    <ItemGroup>
      <_ContentPackFile Include="$(ContentPackDir)\content-pack.json;$(ContentPackDir)\content-version.txt" />
      <MauiAsset Include="@(_ContentPackFile)" LogicalName="content\%(Filename)%(Extension)" />
    </ItemGroup>
  </Target>

</Project>
